<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Plaitway.AppCore.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Tests build small literal arrays on purpose (CA1861), and the daemon calls are bounded by the timeouts of their own helpers rather than by the runner's token (xUnit1051). -->
    <NoWarn>$(NoWarn);CA1861;xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Sources\Plaitway.AppCore\Plaitway.AppCore.csproj" />
    <ProjectReference Include="..\..\Tools\Plaitway.Localization\Plaitway.Localization.csproj" />
  </ItemGroup>

  <!-- The real daemon, as the client tests run it: one set of files, not a copy. They live in the client tests'
       namespace, which they keep. -->
  <ItemGroup>
    <Compile Include="..\Plaitway.Client.Tests\Support\DaemonBinary.cs" Link="Shared\DaemonBinary.cs" />
    <Compile Include="..\Plaitway.Client.Tests\Support\DaemonProcess.cs" Link="Shared\DaemonProcess.cs" />
    <Compile Include="..\Plaitway.Client.Tests\Support\KillOnCloseJob.cs" Link="Shared\KillOnCloseJob.cs" />
    <Compile Include="..\Plaitway.Client.Tests\Support\Repository.cs" Link="Shared\Repository.cs" />
    <Compile Include="..\Plaitway.Client.Tests\Support\Fixture.cs" Link="Shared\Fixture.cs" />
    <Compile Include="..\Plaitway.Client.Tests\Support\TempDirectory.cs" Link="Shared\TempDirectory.cs" />
  </ItemGroup>

</Project>
