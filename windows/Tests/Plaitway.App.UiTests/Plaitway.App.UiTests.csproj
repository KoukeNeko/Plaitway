<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Plaitway.App.UiTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- System.Windows.Automation, which is how the tests see the window as a screen reader does, ships with WPF. -->
    <UseWPF>true</UseWPF>
    <NoWarn>$(NoWarn);CA1861;xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- UseWPF takes System.IO out of the implicit usings, because of System.Windows.Shapes.Path. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Sources\Plaitway.Client\Plaitway.Client.csproj" />
    <!-- The app is started as a program, not called: it is built, and its files are not referenced. Only a Debug build follows
         PLAITWAY_SOCKET, which is how the tests point it at a daemon of their own, so it is the one built whatever the tests are. -->
    <ProjectReference Include="..\..\Sources\Plaitway.App\Plaitway.App.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" SetConfiguration="Configuration=Debug" />
  </ItemGroup>

  <!-- The real daemon on its fake backend, as the other tests run it. -->
  <ItemGroup>
    <Compile Include="..\Plaitway.Client.Tests\Support\DaemonBinary.cs" Link="Shared\DaemonBinary.cs" />
    <Compile Include="..\Plaitway.Client.Tests\Support\DaemonProcess.cs" Link="Shared\DaemonProcess.cs" />
    <Compile Include="..\Plaitway.Client.Tests\Support\KillOnCloseJob.cs" Link="Shared\KillOnCloseJob.cs" />
    <Compile Include="..\Plaitway.Client.Tests\Support\Repository.cs" Link="Shared\Repository.cs" />
    <Compile Include="..\Plaitway.Client.Tests\Support\Fixture.cs" Link="Shared\Fixture.cs" />
    <Compile Include="..\Plaitway.Client.Tests\Support\TempDirectory.cs" Link="Shared\TempDirectory.cs" />
  </ItemGroup>

</Project>
