<Project Sdk="WixToolset.Sdk/5.0.2">

  <!--
    The MSI of Plaitway: per machine, one file for every language of the app, one platform per build.
    packaging\windows\build-installer.ps1 builds it; it stages the payload and passes the version and the folders.

      InstallerPlatform   x64 (default) or arm64; the payload staged for it has to match
      ProductVersion      the VERSION file, major.minor.patch
      ProductCode         derived from the upgrade code, the version, the platform and the payload
                          by the build script, so that a build of the same version with other files is an upgrade
      UpgradeCode         the identity of the product across versions; it never changes
      PayloadDir          the staged files: plaitwayd.exe, plaitway.exe, wintun.dll, app\, licenses\
      LicenseFile         the licence of Plaitway as RTF, for the setup dialog
      Cultures            the language of the setup dialog and of its messages, English; the app's own language
                          is not the installer's business
  -->
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <InstallerPlatform Condition="'$(InstallerPlatform)' == ''">x64</InstallerPlatform>
    <Platform>$(InstallerPlatform)</Platform>
    <OutputName>Plaitway</OutputName>
    <Cultures>en-US</Cultures>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- ICE03: the language lists in the version resources of Microsoft's libraries hold identifiers that ICE03 does not know; the
         language only matters to the installer's choice between two files of one version.
         ICE43, ICE57: the shortcut in the Start menu of all users belongs to a component whose key is the app's file, which is right for a
         per-machine product; the checks assume a per-user shortcut.
         ICE61: a build of the same version with other files replaces the installed one (AllowSameVersionUpgrades), for tests and respins. -->
    <SuppressIces>ICE03;ICE43;ICE57;ICE61</SuppressIces>
    <UpgradeCode>BDA29F25-493D-4DF8-8B16-5A612BC4E954</UpgradeCode>
    <ProductVersion Condition="'$(ProductVersion)' == ''">0.0.0</ProductVersion>
    <PayloadDir Condition="'$(PayloadDir)' == ''">$(MSBuildProjectDirectory)\payload</PayloadDir>
    <IconFile Condition="'$(IconFile)' == ''">$(MSBuildProjectDirectory)\..\Sources\Plaitway.App\Assets\Plaitway.ico</IconFile>
    <LicenseFile Condition="'$(LicenseFile)' == ''">$(PayloadDir)\License.rtf</LicenseFile>
    <DefineConstants>$(DefineConstants);ProductVersion=$(ProductVersion);ProductCode=$(ProductCode);UpgradeCode=$(UpgradeCode);PayloadDir=$(PayloadDir);IconFile=$(IconFile);LicenseFile=$(LicenseFile)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" />
    <PackageReference Include="WixToolset.Util.wixext" />
  </ItemGroup>

</Project>
