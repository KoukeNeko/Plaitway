<UserControl x:Class="Plaitway.App.Controls.TrafficSparkline"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsTabStop="False"
             AutomationProperties.AccessibilityView="Raw"
             SizeChanged="OnSizeChanged">
  <!-- Both directions on one scale: received as a filled area, sent as a dashed line, so that they differ by shape and not by colour. The numbers are above it. -->
  <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="4" Padding="0">
    <Grid>
      <Polygon x:Name="ReceivedArea" Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.3" />
      <Polyline x:Name="ReceivedLine" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="2" StrokeLineJoin="Round" />
      <Polyline x:Name="SentLine" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.5" StrokeDashArray="4 3" StrokeLineJoin="Round" />
    </Grid>
  </Border>
</UserControl>
