<ContentDialog x:Class="Plaitway.App.Dialogs.CredentialDialog"
               Style="{StaticResource DefaultContentDialogStyle}"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:controls="using:Plaitway.App.Controls"
               Title="{x:Bind ViewModel.Title}"
               PrimaryButtonText="{x:Bind ViewModel.Text.Connect}"
               CloseButtonText="{x:Bind ViewModel.Text.Cancel}"
               DefaultButton="Primary"
               IsPrimaryButtonEnabled="{x:Bind ViewModel.CanSubmit, Mode=OneWay}"
               PrimaryButtonClick="OnPrimaryClick"
               CloseButtonClick="OnCloseClick">
  <StackPanel Spacing="12" MinWidth="320">
    <TextBlock Text="{x:Bind ViewModel.ProfileName}" Style="{StaticResource SecondaryTextStyle}" />
    <TextBlock x:Name="RejectionText" Text="{x:Bind ViewModel.RejectionMessage}" Style="{StaticResource ErrorTextStyle}"
               Visibility="{x:Bind controls:Bind.Visible(ViewModel.IsRejected)}" />
    <TextBox x:Name="UsernameBox" Header="{x:Bind ViewModel.Text.Username}" Text="{x:Bind ViewModel.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
             Visibility="{x:Bind controls:Bind.Visible(ViewModel.AsksForUsername)}" />
    <PasswordBox x:Name="SecretBox" Header="{x:Bind ViewModel.SecretLabel}" Password="{x:Bind ViewModel.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
  </StackPanel>
</ContentDialog>
