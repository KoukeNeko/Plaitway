<ContentDialog x:Class="Plaitway.App.Dialogs.ImportReportDialog"
               Style="{StaticResource DefaultContentDialogStyle}"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:controls="using:Plaitway.App.Controls"
               xmlns:vm="using:Plaitway.AppCore.ViewModels"
               Title="{x:Bind ViewModel.Text.Import}"
               CloseButtonText="{x:Bind ViewModel.Text.Close}"
               DefaultButton="Close">
  <ListView ItemsSource="{x:Bind ViewModel.Rows}" SelectionMode="None" MinWidth="440" MaxHeight="360"
            AutomationProperties.Name="{x:Bind ViewModel.Text.Import}">
    <ListView.ItemTemplate>
      <DataTemplate x:DataType="vm:ImportRow">
        <Grid ColumnSpacing="12" Padding="0,6" AutomationProperties.Name="{x:Bind AutomationName}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <controls:StatusGlyph Icon="{x:Bind Icon}" Tone="{x:Bind Tone}" VerticalAlignment="Top" />
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock Text="{x:Bind Filename}" TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind ProfileName}" Style="{StaticResource CaptionSecondaryTextStyle}" Visibility="{x:Bind controls:Bind.VisibleIfText(ProfileName)}" />
            <ItemsControl ItemsSource="{x:Bind Details}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <!-- The reason is what the user acts on: full size, and selectable to be copied. -->
                  <TextBlock Text="{x:Bind}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Grid>
      </DataTemplate>
    </ListView.ItemTemplate>
  </ListView>
</ContentDialog>
