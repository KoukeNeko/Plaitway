<UserControl x:Class="Plaitway.App.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Plaitway.App.Controls"
             IsTabStop="False">
  <!-- The helper is not ready: one thing to do about it. -->
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="520" Padding="24">
    <controls:StatusGlyph Icon="{x:Bind ViewModel.Icon, Mode=OneWay}" Tone="Neutral" GlyphSize="56" HorizontalAlignment="Center" />
    <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource PageTitleStyle}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
    <TextBlock Text="{x:Bind ViewModel.Detail, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Center" TextAlignment="Center"
               IsTextSelectionEnabled="True" Visibility="{x:Bind controls:Bind.Visible(ViewModel.HasDetail), Mode=OneWay}" />
    <ProgressRing IsActive="{x:Bind ViewModel.ShowsProgress, Mode=OneWay}" Width="32" Height="32" HorizontalAlignment="Center"
                  AutomationProperties.Name="{x:Bind ViewModel.Title, Mode=OneWay}"
                  Visibility="{x:Bind controls:Bind.Visible(ViewModel.ShowsProgress), Mode=OneWay}" />
    <Button Content="{x:Bind ViewModel.PrimaryLabel, Mode=OneWay}" Command="{x:Bind ViewModel.PrimaryCommand}" Style="{StaticResource AccentButtonStyle}"
            HorizontalAlignment="Center" Visibility="{x:Bind controls:Bind.Visible(ViewModel.HasPrimary), Mode=OneWay}" />
    <HyperlinkButton Content="{x:Bind ViewModel.SecondaryLabel, Mode=OneWay}" Command="{x:Bind ViewModel.SecondaryCommand}"
                     HorizontalAlignment="Center" Visibility="{x:Bind controls:Bind.Visible(ViewModel.HasSecondary), Mode=OneWay}" />
  </StackPanel>
</UserControl>
