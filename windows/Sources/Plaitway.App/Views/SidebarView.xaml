<UserControl x:Class="Plaitway.App.Views.SidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Plaitway.App.Controls"
             xmlns:vm="using:Plaitway.AppCore.ViewModels"
             IsTabStop="False">
  <Grid Padding="8,8,8,8" RowSpacing="4">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- The profiles, in priority order. -->
    <Grid Padding="12,4,4,4" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{x:Bind ViewModel.Text.Profiles}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"
                 AutomationProperties.HeadingLevel="Level2" />
      <Button Grid.Column="1" x:Name="ImportButton" Command="{x:Bind ImportCommand, Mode=OneWay}"
              AutomationProperties.Name="{x:Bind ViewModel.Text.ImportProfileEllipsis}" ToolTipService.ToolTip="{x:Bind ViewModel.Text.ImportProfileEllipsis}">
        <FontIcon Glyph="&#xE710;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" />
      </Button>
    </Grid>

    <ListView x:Name="ProfileList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Rows}" SelectionMode="Single"
              CanReorderItems="True" CanDragItems="True" AllowDrop="True"
              AutomationProperties.Name="{x:Bind ViewModel.Text.Profiles}"
              SelectionChanged="OnProfileSelectionChanged" DragItemsCompleted="OnDragItemsCompleted" KeyDown="OnProfileListKeyDown">
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="vm:ProfileRowViewModel">
          <Grid ColumnSpacing="12" Padding="0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:StatusGlyph Icon="{x:Bind Icon, Mode=OneWay}" Tone="{x:Bind Tone, Mode=OneWay}" GlyphSize="{StaticResource IconSizeInList}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Spacing="0">
              <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" Style="{StaticResource CaptionSecondaryTextStyle}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Grid.ContextFlyout>
              <MenuFlyout>
                <MenuFlyoutItem Text="{x:Bind ToggleLabel, Mode=OneWay}" Command="{x:Bind ToggleCommand}" IsEnabled="{x:Bind CanToggle, Mode=OneWay}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="{x:Bind Text.MoveUp}" Command="{x:Bind MoveUpCommand}" />
                <MenuFlyoutItem Text="{x:Bind Text.MoveDown}" Command="{x:Bind MoveDownCommand}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="{x:Bind Text.DeleteProfileEllipsis}" Command="{x:Bind DeleteCommand}" />
              </MenuFlyout>
            </Grid.ContextFlyout>
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>

    <!-- Diagnostics and Settings: the same column as the profiles above them. -->
    <ListView x:Name="FooterList" Grid.Row="2" SelectionMode="Single" SelectionChanged="OnFooterSelectionChanged" AutomationProperties.Name="{x:Bind controls:Bind.Join(ViewModel.Text.Diagnostics, ViewModel.Text.Settings)}">
      <ListViewItem x:Name="DiagnosticsItem" AutomationProperties.Name="{x:Bind ViewModel.Text.Diagnostics}">
        <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,4">
          <FontIcon Glyph="&#xE9D9;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="{StaticResource IconSizeInList}" AutomationProperties.AccessibilityView="Raw" />
          <TextBlock Text="{x:Bind ViewModel.Text.Diagnostics}" VerticalAlignment="Center" />
        </StackPanel>
      </ListViewItem>
      <ListViewItem x:Name="SettingsItem" AutomationProperties.Name="{x:Bind ViewModel.Text.Settings}">
        <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,4">
          <FontIcon Glyph="&#xE713;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="{StaticResource IconSizeInList}" AutomationProperties.AccessibilityView="Raw" />
          <TextBlock Text="{x:Bind ViewModel.Text.Settings}" VerticalAlignment="Center" />
        </StackPanel>
      </ListViewItem>
    </ListView>
  </Grid>
</UserControl>
