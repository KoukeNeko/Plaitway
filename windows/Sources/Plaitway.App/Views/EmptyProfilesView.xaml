<UserControl x:Class="Plaitway.App.Views.EmptyProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Plaitway.App.Controls"
             IsTabStop="False">
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
    <controls:StatusGlyph Icon="Idle" Tone="Neutral" GlyphSize="56" HorizontalAlignment="Center" />
    <TextBlock Text="{x:Bind ViewModel.Text.NoProfiles}" Style="{StaticResource PageTitleStyle}" HorizontalAlignment="Center" />
    <Button Content="{x:Bind ViewModel.Text.ImportProfileEllipsis}" Command="{x:Bind ViewModel.ImportCommand}" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" />
  </StackPanel>
</UserControl>
