<UserControl x:Class="Plaitway.App.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Plaitway.App.Controls"
             xmlns:local="using:Plaitway.App.Views"
             xmlns:vm="using:Plaitway.AppCore.ViewModels"
             IsTabStop="False">
  <Grid RowSpacing="0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TextBlock Text="{x:Bind ViewModel.Text.Diagnostics}" Style="{StaticResource PageTitleStyle}" Margin="24,16,24,0" />

    <Pivot Grid.Row="1" SelectedIndex="{x:Bind ViewModel.SelectedTabIndex, Mode=TwoWay}" AutomationProperties.Name="{x:Bind ViewModel.Text.Diagnostics}">
      <PivotItem Header="{x:Bind ViewModel.OverviewLabel}">
        <Grid RowSpacing="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Grid Padding="24,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="{x:Bind ViewModel.Text.CopyReport}" Command="{x:Bind ViewModel.CopyReportCommand}" />
            <Button Grid.Column="2" Content="{x:Bind ViewModel.Text.Resync}" Command="{x:Bind ViewModel.ResyncCommand}" />
          </Grid>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" IsTabStop="False">
            <StackPanel Padding="24,0,24,16" Spacing="{StaticResource SectionSpacing}" MaxWidth="{StaticResource PageMaxWidth}">
              <TextBlock Text="{x:Bind ViewModel.Failure, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Center"
                         Visibility="{x:Bind controls:Bind.Hidden(ViewModel.HasReading), Mode=OneWay}" />
              <ProgressRing Width="28" Height="28" AutomationProperties.Name="{x:Bind ViewModel.Text.Diagnostics}" IsActive="{x:Bind controls:Bind.Not(ViewModel.HasReading), Mode=OneWay}"
                            Visibility="{x:Bind controls:Bind.Hidden(ViewModel.HasReading), Mode=OneWay}" />

              <!-- What needs doing comes first: the product exists to leave none of these behind. -->
              <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind controls:Bind.Visible(ViewModel.HasStaleRoutes), Mode=OneWay}">
                <StackPanel Spacing="8">
                  <TextBlock Text="{x:Bind ViewModel.Text.StaleRoutes}" Style="{StaticResource SectionHeaderStyle}" />
                  <ItemsControl ItemsSource="{x:Bind ViewModel.StaleRoutes, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:StaleRouteRow">
                        <Grid ColumnSpacing="12" Padding="0,6">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <controls:StatusGlyph Icon="RouteBlocked" Tone="Caution" VerticalAlignment="Top" />
                          <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{x:Bind Prefix}" Style="{StaticResource MonospaceTextStyle}" />
                            <TextBlock Text="{x:Bind Via}" Style="{StaticResource CaptionSecondaryTextStyle}" IsTextSelectionEnabled="True" />
                            <TextBlock Text="{x:Bind Reason}" Style="{StaticResource CaptionSecondaryTextStyle}" IsTextSelectionEnabled="True" />
                            <TextBlock Text="{x:Bind InstalledByLabel}" Style="{StaticResource CaptionSecondaryTextStyle}"
                                       Visibility="{x:Bind controls:Bind.Visible(InstalledByPlaitway)}" />
                          </StackPanel>
                          <Button Grid.Column="2" Content="{x:Bind RemoveLabel}" Click="OnRemoveStaleClick" Tag="{x:Bind}"
                                  AutomationProperties.Name="{x:Bind RemoveName}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind controls:Bind.VisibleIfAny(ViewModel.Network.Count), Mode=OneWay}">
                <StackPanel>
                  <TextBlock Text="{x:Bind ViewModel.Text.Network}" Style="{StaticResource SectionHeaderStyle}" />
                  <controls:DetailRows Rows="{x:Bind ViewModel.Network, Mode=OneWay}" />
                </StackPanel>
              </Border>

              <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind controls:Bind.Visible(ViewModel.HasReading), Mode=OneWay}">
                <StackPanel Spacing="4">
                  <TextBlock Text="{x:Bind ViewModel.Text.Routes}" Style="{StaticResource SectionHeaderStyle}" />
                  <TextBlock Text="{x:Bind ViewModel.Text.None}" Style="{StaticResource SecondaryTextStyle}"
                             Visibility="{x:Bind controls:Bind.Visible(ViewModel.HasNoOwnedRoutes), Mode=OneWay}" />
                  <ItemsControl ItemsSource="{x:Bind ViewModel.OwnedRoutes, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:OwnedRouteRow">
                        <Grid ColumnSpacing="16" Padding="0,6">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind Prefix}" Style="{StaticResource MonospaceTextStyle}" />
                            <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionSecondaryTextStyle}" IsTextSelectionEnabled="True" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                            <controls:StatusGlyph Icon="{x:Bind Icon}" Tone="{x:Bind Tone}" />
                            <TextBlock Text="{x:Bind StateLabel}" />
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <Expander Header="{x:Bind ViewModel.Text.ResolverEntries}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Visibility="{x:Bind controls:Bind.Visible(ViewModel.HasReading), Mode=OneWay}">
                <StackPanel Spacing="4">
                  <TextBlock Text="{x:Bind ViewModel.Text.None}" Style="{StaticResource SecondaryTextStyle}"
                             Visibility="{x:Bind controls:Bind.VisibleIfNone(ViewModel.ResolverEntries.Count), Mode=OneWay}" />
                  <ItemsControl ItemsSource="{x:Bind ViewModel.ResolverEntries, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{x:Bind}" Style="{StaticResource MonospaceTextStyle}" TextWrapping="Wrap" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Expander>

              <Expander Header="{x:Bind ViewModel.Text.RecentChanges}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Visibility="{x:Bind controls:Bind.Visible(ViewModel.HasReading), Mode=OneWay}">
                <StackPanel Spacing="4">
                  <TextBlock Text="{x:Bind ViewModel.Text.None}" Style="{StaticResource SecondaryTextStyle}"
                             Visibility="{x:Bind controls:Bind.VisibleIfNone(ViewModel.Journal.Count), Mode=OneWay}" />
                  <ItemsControl ItemsSource="{x:Bind ViewModel.Journal, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:JournalRow">
                        <Grid ColumnSpacing="16" Padding="0,4">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource MonospaceTextStyle}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind Caption}" Style="{StaticResource CaptionSecondaryTextStyle}" />
                          </StackPanel>
                          <TextBlock Grid.Column="1" Text="{x:Bind State}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </PivotItem>

      <PivotItem Header="{x:Bind ViewModel.HelperLogLabel}">
        <local:LogsView ViewModel="{x:Bind ViewModel.HelperLog}" />
      </PivotItem>
    </Pivot>
  </Grid>
</UserControl>
