<UserControl x:Class="Plaitway.App.Views.AppSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Plaitway.App.Controls"
             IsTabStop="False">
  <ScrollViewer VerticalScrollBarVisibility="Auto" IsTabStop="False">
    <StackPanel Padding="{StaticResource PagePadding}" Spacing="{StaticResource SectionSpacing}" MaxWidth="{StaticResource PageMaxWidth}">
      <TextBlock Text="{x:Bind ViewModel.Text.Settings}" Style="{StaticResource PageTitleStyle}" />

      <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind controls:Bind.Visible(ViewModel.CanSetLaunchAtLogin)}">
        <ToggleSwitch Header="{x:Bind ViewModel.Text.LaunchAtLogin}" IsOn="{x:Bind ViewModel.LaunchAtLogin, Mode=TwoWay}" />
      </Border>

      <Border Style="{StaticResource CardStyle}">
        <StackPanel Spacing="8">
          <TextBlock Text="{x:Bind ViewModel.Text.Helper}" Style="{StaticResource SectionHeaderStyle}" />
          <controls:DetailRows Rows="{x:Bind ViewModel.Helper, Mode=OneWay}" />
          <StackPanel Orientation="Horizontal" Spacing="8" Padding="0,8,0,0" Visibility="{x:Bind controls:Bind.Visible(ViewModel.CanManageHelper), Mode=OneWay}">
            <Button Content="{x:Bind ViewModel.Text.StartHelper}" Command="{x:Bind ViewModel.StartHelperCommand}"
                    Visibility="{x:Bind controls:Bind.Visible(ViewModel.CanStartHelper), Mode=OneWay}" />
            <Button Content="{x:Bind ViewModel.Text.ReinstallHelper}" Command="{x:Bind ViewModel.RequestReinstallCommand}" />
            <Button Content="{x:Bind ViewModel.Text.UninstallHelperEllipsis}" Command="{x:Bind ViewModel.RequestUninstallCommand}"
                    IsEnabled="{x:Bind ViewModel.CanUninstallHelper, Mode=OneWay}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
