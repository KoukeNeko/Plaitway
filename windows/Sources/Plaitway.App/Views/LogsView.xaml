<UserControl x:Class="Plaitway.App.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Plaitway.App.Controls"
             xmlns:local="using:Plaitway.App.Views"
             xmlns:logs="using:Plaitway.AppCore.Logs"
             xmlns:vm="using:Plaitway.AppCore.ViewModels"
             IsTabStop="False">
  <Grid RowSpacing="0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- What can be done with the log. -->
    <Grid Padding="24,8" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox x:Name="SearchBox" Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               PlaceholderText="{x:Bind ViewModel.Text.SearchLogs}"
               AutomationProperties.Name="{x:Bind ViewModel.Text.SearchLogs}" />
      <ComboBox Grid.Column="1" ItemsSource="{x:Bind ViewModel.Choices}" SelectedItem="{x:Bind ViewModel.SelectedChoice, Mode=OneWay}" SelectionChanged="OnLevelChosen"
                DisplayMemberPath="Label" AutomationProperties.Name="{x:Bind ViewModel.Text.Level}" MinWidth="180" />
      <Button Grid.Column="2" Command="{x:Bind ViewModel.ScrollToLatestCommand}" IsEnabled="{x:Bind controls:Bind.Not(ViewModel.IsAtEnd), Mode=OneWay}"
              AutomationProperties.Name="{x:Bind ViewModel.Text.Latest}" ToolTipService.ToolTip="{x:Bind ViewModel.Text.Latest}">
        <FontIcon Glyph="&#xE74B;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" />
      </Button>
      <Button Grid.Column="3" Command="{x:Bind ViewModel.CopyCommand}"
              AutomationProperties.Name="{x:Bind ViewModel.Text.Copy}" ToolTipService.ToolTip="{x:Bind ViewModel.Text.Copy}">
        <FontIcon Glyph="&#xE8C8;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" />
      </Button>
    </Grid>

    <Grid Grid.Row="1">
      <ListView x:Name="LineList" ItemsSource="{x:Bind ViewModel.Lines, Mode=OneWay}" SelectionMode="Extended" Padding="12,0"
                AutomationProperties.Name="{x:Bind ViewModel.Text.Logs}"
                Visibility="{x:Bind controls:Bind.VisibleIfAny(ViewModel.Lines.Count), Mode=OneWay}">
        <ListView.ItemContainerStyle>
          <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Padding" Value="12,1" />
          </Style>
        </ListView.ItemContainerStyle>
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="logs:LogEntry">
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{x:Bind local:LogsView.TimeOf(Time)}" Style="{StaticResource MonospaceTextStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
              <controls:ToneText Grid.Column="1" Text="{x:Bind local:LogsView.TagOf(Level)}" Tone="{x:Bind local:LogsView.ToneOf(Level)}" />
              <TextBlock Grid.Column="2" Text="{x:Bind Text}" Style="{StaticResource MonospaceTextStyle}" FontSize="12" TextWrapping="Wrap" />
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>

      <TextBlock Text="{x:Bind ViewModel.Text.NoLogLines}" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Visibility="{x:Bind controls:Bind.Visible(ViewModel.ShowsEmptyLog), Mode=OneWay}" />
      <TextBlock Text="{x:Bind ViewModel.Query, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}"
                 Visibility="{x:Bind controls:Bind.Visible(ViewModel.ShowsNoMatch), Mode=OneWay}" />
    </Grid>
  </Grid>
</UserControl>
