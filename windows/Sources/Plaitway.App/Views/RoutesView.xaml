<UserControl x:Class="Plaitway.App.Views.RoutesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Plaitway.App.Controls"
             xmlns:local="using:Plaitway.App.Views"
             xmlns:presentation="using:Plaitway.AppCore.Presentation"
             IsTabStop="False">
  <Grid>
    <!-- Nothing to list. -->
    <StackPanel Visibility="{x:Bind controls:Bind.Visible(ViewModel.IsEmpty), Mode=OneWay}"
                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
      <FontIcon Glyph="&#xE8AB;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="40"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AccessibilityView="Raw" HorizontalAlignment="Center" />
      <TextBlock Text="{x:Bind ViewModel.Text.NoRoutes}" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto" IsTabStop="False" Visibility="{x:Bind controls:Bind.Hidden(ViewModel.IsEmpty), Mode=OneWay}">
      <StackPanel Padding="{StaticResource PagePadding}" Spacing="{StaticResource SectionSpacing}" MaxWidth="{StaticResource PageMaxWidth}">

        <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind controls:Bind.VisibleIfAny(ViewModel.Routes.Count), Mode=OneWay}">
          <StackPanel Spacing="4">
            <TextBlock Text="{x:Bind ViewModel.Text.Routes}" Style="{StaticResource SectionHeaderStyle}" />
            <Grid ColumnSpacing="16" Padding="0,0,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="150" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="4*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{x:Bind ViewModel.Text.Prefix}" Style="{StaticResource CaptionSecondaryTextStyle}" />
              <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Text.State}" Style="{StaticResource CaptionSecondaryTextStyle}" />
              <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.Text.Reason}" Style="{StaticResource CaptionSecondaryTextStyle}" />
            </Grid>
            <ListView x:Name="RouteList" ItemsSource="{x:Bind ViewModel.Routes, Mode=OneWay}" SelectionMode="Extended"
                      ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                      AutomationProperties.Name="{x:Bind ViewModel.Text.Routes}">
              <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                  <Setter Property="MinHeight" Value="36" />
                  <Setter Property="Padding" Value="0" />
                </Style>
              </ListView.ItemContainerStyle>
              <ListView.ItemTemplate>
                <DataTemplate x:DataType="presentation:RouteRow">
                  <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="3*" MinWidth="150" />
                      <ColumnDefinition Width="3*" />
                      <ColumnDefinition Width="4*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Prefix}" Style="{StaticResource MonospaceTextStyle}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                Visibility="{x:Bind controls:Bind.VisibleIfText(StateLabel)}">
                      <controls:StatusGlyph Icon="{x:Bind local:RoutesView.IconOf(State)}" Tone="{x:Bind local:RoutesView.ToneOf(State)}" />
                      <TextBlock Text="{x:Bind StateLabel}" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{x:Bind Detail}" Style="{StaticResource SecondaryTextStyle}" IsTextSelectionEnabled="True" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
              <ListView.ContextFlyout>
                <MenuFlyout>
                  <MenuFlyoutItem Text="{x:Bind ViewModel.Text.Copy, Mode=OneWay}" Click="OnCopyClick" />
                </MenuFlyout>
              </ListView.ContextFlyout>
            </ListView>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind controls:Bind.Visible(ViewModel.HasDns), Mode=OneWay}">
          <StackPanel Spacing="8">
            <TextBlock Text="{x:Bind ViewModel.Text.DNS}" Style="{StaticResource SectionHeaderStyle}" />
            <TextBlock Text="{x:Bind ViewModel.DeclaredDns, Mode=OneWay}" Style="{StaticResource MonospaceTextStyle}"
                       Visibility="{x:Bind controls:Bind.VisibleIfNone(ViewModel.Dns.Count), Mode=OneWay}" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Dns, Mode=OneWay}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="presentation:DnsRow">
                  <Grid ColumnSpacing="16" Padding="0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                      <TextBlock Text="{x:Bind Servers}" Style="{StaticResource MonospaceTextStyle}" />
                      <TextBlock Text="{x:Bind Domains}" Style="{StaticResource CaptionSecondaryTextStyle}" IsTextSelectionEnabled="True" />
                      <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionSecondaryTextStyle}" IsTextSelectionEnabled="True"
                                 Visibility="{x:Bind controls:Bind.VisibleIfText(Detail)}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                      <controls:StatusGlyph Icon="{x:Bind local:RoutesView.IconOf(State)}" Tone="{x:Bind local:RoutesView.ToneOf(State)}" />
                      <TextBlock Text="{x:Bind StateLabel}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
