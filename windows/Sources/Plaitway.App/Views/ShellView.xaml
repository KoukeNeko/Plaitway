<UserControl x:Class="Plaitway.App.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Plaitway.App.Controls"
             xmlns:local="using:Plaitway.App.Views"
             xmlns:vm="using:Plaitway.AppCore.ViewModels"
             IsTabStop="False" KeyboardAcceleratorPlacementMode="Hidden">
  <UserControl.Resources>
    <!-- One template per page: a new page is a view, a view model and a line here. -->
    <DataTemplate x:Key="ProfileTemplate" x:DataType="vm:ProfilePageViewModel">
      <local:ProfileView ViewModel="{x:Bind}" />
    </DataTemplate>
    <DataTemplate x:Key="DiagnosticsTemplate" x:DataType="vm:DiagnosticsViewModel">
      <local:DiagnosticsView ViewModel="{x:Bind}" />
    </DataTemplate>
    <DataTemplate x:Key="SettingsTemplate" x:DataType="vm:AppSettingsViewModel">
      <local:AppSettingsView ViewModel="{x:Bind}" />
    </DataTemplate>
    <DataTemplate x:Key="EmptyTemplate" x:DataType="vm:EmptyProfilesViewModel">
      <local:EmptyProfilesView ViewModel="{x:Bind}" />
    </DataTemplate>
    <local:PageTemplateSelector x:Key="PageTemplates"
                                Profile="{StaticResource ProfileTemplate}"
                                Diagnostics="{StaticResource DiagnosticsTemplate}"
                                Settings="{StaticResource SettingsTemplate}"
                                Empty="{StaticResource EmptyTemplate}" />
  </UserControl.Resources>

  <Grid Background="Transparent" AllowDrop="True" DragEnter="OnDragOver" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">
    <!-- The helper is not ready and there are no profiles to keep in view: one thing to do. -->
    <local:SetupView ViewModel="{x:Bind ViewModel.Setup}" Visibility="{x:Bind controls:Bind.Visible(ViewModel.ShowsSetup), Mode=OneWay}" />

    <Grid x:Name="MainLayout" Visibility="{x:Bind controls:Bind.Visible(ViewModel.ShowsProfiles), Mode=OneWay}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{StaticResource SidebarWidth}" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <local:SidebarView x:Name="Sidebar" ViewModel="{x:Bind ViewModel.Sidebar}" ImportCommand="{x:Bind ViewModel.ImportCommand}" />

      <Border Grid.Column="1" Style="{StaticResource PageLayerStyle}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <!-- Something the user may want to act on. -->
          <InfoBar Severity="Warning" IsClosable="False" IsOpen="{x:Bind ViewModel.HasBanner, Mode=OneWay}"
                   Title="{x:Bind ViewModel.Banner.Title, Mode=OneWay}" Message="{x:Bind ViewModel.Banner.Detail, Mode=OneWay}" Margin="12,12,12,0">
            <InfoBar.ActionButton>
              <Button Content="{x:Bind ViewModel.Banner.ActionLabel, Mode=OneWay}" Command="{x:Bind ViewModel.PerformBannerActionCommand}"
                      Visibility="{x:Bind controls:Bind.VisibleIfText(ViewModel.Banner.ActionLabel), Mode=OneWay}" />
            </InfoBar.ActionButton>
            <TextBlock Text="{x:Bind ViewModel.Banner.Hint, Mode=OneWay}" IsTextSelectionEnabled="True" TextWrapping="Wrap" Margin="0,0,0,12"
                       Visibility="{x:Bind controls:Bind.VisibleIfText(ViewModel.Banner.Hint), Mode=OneWay}" />
          </InfoBar>

          <ContentControl x:Name="PageHost" Grid.Row="1" ContentTemplateSelector="{StaticResource PageTemplates}"
                          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False" />
        </Grid>
      </Border>
    </Grid>

    <!-- A drop imports: the outline the macOS window takes on. -->
    <Border BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="2" IsHitTestVisible="False"
            Visibility="{x:Bind controls:Bind.Visible(ViewModel.ShowsDropHint), Mode=OneWay}" />
  </Grid>
</UserControl>
