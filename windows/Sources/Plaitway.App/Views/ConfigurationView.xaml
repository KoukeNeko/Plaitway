<UserControl x:Class="Plaitway.App.Views.ConfigurationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Plaitway.App.Controls"
             IsTabStop="False">
  <Grid RowSpacing="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- What can be done with the text. -->
    <Grid Padding="24,8,24,0" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Content="{x:Bind ViewModel.Text.Revert}" Command="{x:Bind ViewModel.RevertCommand}" IsEnabled="{x:Bind ViewModel.IsDirty, Mode=OneWay}" />
      <Button Grid.Column="1" Content="{x:Bind ViewModel.SecretsLabel, Mode=OneWay}" Command="{x:Bind ViewModel.ToggleSecretsCommand}"
              IsEnabled="{x:Bind ViewModel.IsReady, Mode=OneWay}" />

      <!-- A running profile keeps the text it started with: the user says whether to restart it. -->
      <SplitButton Grid.Column="3" Content="{x:Bind ViewModel.Text.Save}" Command="{x:Bind ViewModel.SaveCommand}"
                   Visibility="{x:Bind controls:Bind.Visible(ViewModel.OffersReconnect), Mode=OneWay}">
        <SplitButton.Flyout>
          <MenuFlyout Placement="BottomEdgeAlignedRight">
            <MenuFlyoutItem Text="{x:Bind ViewModel.Text.SaveAndReconnect}" Command="{x:Bind ViewModel.SaveAndReconnectCommand}" />
          </MenuFlyout>
        </SplitButton.Flyout>
      </SplitButton>
      <Button Grid.Column="3" Content="{x:Bind ViewModel.Text.Save}" Command="{x:Bind ViewModel.SaveCommand}" Style="{StaticResource AccentButtonStyle}"
              Visibility="{x:Bind controls:Bind.Hidden(ViewModel.OffersReconnect), Mode=OneWay}" />
    </Grid>

    <!-- What the daemon said about the text. -->
    <StackPanel Grid.Row="1" Padding="24,0" Spacing="8">
      <InfoBar Severity="Error" IsOpen="{x:Bind ViewModel.HasDiagnostic, Mode=OneWay}" IsClosable="False" Visibility="{x:Bind controls:Bind.Visible(ViewModel.HasDiagnostic), Mode=OneWay}"
               Title="{x:Bind ViewModel.DiagnosticPlace, Mode=OneWay}" Message="{x:Bind ViewModel.DiagnosticMessage, Mode=OneWay}" />
      <InfoBar Severity="Warning" IsOpen="{x:Bind ViewModel.HasWarnings, Mode=OneWay}" IsClosable="False" Visibility="{x:Bind controls:Bind.Visible(ViewModel.HasWarnings), Mode=OneWay}">
        <ItemsControl ItemsSource="{x:Bind ViewModel.Warnings, Mode=OneWay}" Padding="0,0,0,12">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{x:Bind}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </InfoBar>
      <InfoBar Severity="Informational" IsOpen="{x:Bind ViewModel.RunsOldText, Mode=OneWay}" IsClosable="False" Visibility="{x:Bind controls:Bind.Visible(ViewModel.RunsOldText), Mode=OneWay}" Message="{x:Bind ViewModel.Text.AppliesAtNextConnection}" />
    </StackPanel>

    <!-- The text, or why there is none. -->
    <Grid Grid.Row="2" Padding="24,0,24,16">
      <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Bind ViewModel.Text.Configuration}"
                    Visibility="{x:Bind controls:Bind.Visible(ViewModel.IsLoading), Mode=OneWay}" />
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="{x:Bind controls:Bind.Visible(ViewModel.IsUnavailable), Mode=OneWay}">
        <FontIcon Glyph="&#xE72E;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="40" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  AutomationProperties.AccessibilityView="Raw" />
        <TextBlock Text="{x:Bind ViewModel.UnavailableMessage, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" HorizontalAlignment="Center" />
      </StackPanel>
      <TextBox x:Name="Editor" Text="{x:Bind ViewModel.Content, Mode=OneWay}" TextChanged="OnEditorTextChanged"
               AutomationProperties.Name="{x:Bind ViewModel.Text.Configuration}"
               AcceptsReturn="True" TextWrapping="NoWrap" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
               FontFamily="Cascadia Mono, Consolas" FontSize="13" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
               ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
               IsEnabled="{x:Bind controls:Bind.Not(ViewModel.IsSaving), Mode=OneWay}"
               Visibility="{x:Bind controls:Bind.Visible(ViewModel.IsReady), Mode=OneWay}">
        <TextBox.KeyboardAccelerators>
          <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="OnSaveInvoked" />
        </TextBox.KeyboardAccelerators>
      </TextBox>
    </Grid>
  </Grid>
</UserControl>
