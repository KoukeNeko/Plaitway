<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Only theme resources: every colour follows the theme, the high-contrast themes included. -->

  <x:Double x:Key="PageMaxWidth">960</x:Double>
  <GridLength x:Key="SidebarWidth">280</GridLength>
  <x:Double x:Key="IconSizeInList">20</x:Double>
  <Thickness x:Key="PagePadding">24,16,24,16</Thickness>
  <x:Double x:Key="SectionSpacing">16</x:Double>

  <!-- The headers of a pivot are the names of tabs, not titles: the default is the size of a heading. -->
  <x:Double x:Key="PivotHeaderItemFontSize">16</x:Double>

  <Style x:Key="CardStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="CaptionSecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
  </Style>

  <Style x:Key="MonospaceTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
    <Setter Property="IsTextSelectionEnabled" Value="True" />
  </Style>

  <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
  </Style>

  <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
    <Setter Property="AutomationProperties.HeadingLevel" Value="Level1" />
  </Style>

  <Style x:Key="ErrorTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="IsTextSelectionEnabled" Value="True" />
  </Style>

  <!-- The page sits on a layer above the window's backdrop, as the content of the Settings app does. -->
  <Style x:Key="PageLayerStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1,1,0,0" />
    <Setter Property="CornerRadius" Value="8,0,0,0" />
  </Style>


  <!-- The switch says on or off by its position; its own words would come in the language of Windows, not the app's. -->
  <Style TargetType="ToggleSwitch" BasedOn="{StaticResource DefaultToggleSwitchStyle}">
    <Setter Property="OnContent" Value="" />
    <Setter Property="OffContent" Value="" />
  </Style>
</ResourceDictionary>
