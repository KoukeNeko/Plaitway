<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Plaitway.Client</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <!-- The only definition of the API. Types are generated into obj/ on every build and never committed. -->
    <Protobuf Include="..\..\..\proto\plaitway\v1\plaitway.proto" ProtoRoot="..\..\..\proto" GrpcServices="Client" Link="Protos\plaitway.proto" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Plaitway.Client.Tests" />
  </ItemGroup>

</Project>
