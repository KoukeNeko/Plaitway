# Exported from an ASUSWRT-Merlin router
# Profile name: Home Merlin
client
dev tun
proto udp4
remote 203.0.113.7 1194
remote-cert-tls server
nobind
persist-key
persist-tun
auth-user-pass
ncp-ciphers AES-256-GCM:AES-128-GCM:AES-128-CBC
auth SHA256
compress
verb 3
dhcp-option DNS 192.168.1.1
dhcp-option DOMAIN lan.example
redirect-gateway def1
<ca>
-----BEGIN CERTIFICATE-----
bWVybGluIGNh
-----END CERTIFICATE-----
</ca>
<cert>
-----BEGIN CERTIFICATE-----
bWVybGluIGNlcnQ=
-----END CERTIFICATE-----
</cert>
<key>
-----BEGIN PRIVATE KEY-----
bWVybGluIGtleQ==
-----END PRIVATE KEY-----
</key>
<tls-crypt>
-----BEGIN OpenVPN Static key V1-----
ffeeddccbbaa99887766554433221100
-----END OpenVPN Static key V1-----
</tls-crypt>
